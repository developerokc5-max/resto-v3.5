APP_NAME=HawkerOps
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app.onrender.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=pgsql

# Neon PostgreSQL connection string
NEON_DB=postgresql://neondb_owner:npg_wyPJBlNc2CH9@ep-lively-surf-a1g3ts14-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

VITE_APP_NAME="${APP_NAME}"

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_EMAILS=

# Admin login fallback
ADMIN_USERNAME=
ADMIN_PASSWORD=

# RestoSuite / Tabsquare API
RESTOSUITE_BASE_URL=https://openapi.sea.restosuite.ai
RESTOSUITE_APP_KEY=your_app_key_here
RESTOSUITE_APP_ID=your_app_id_here

# Resend email alerts
RESEND_API_KEY=
ALERT_FROM_EMAIL=
ALERT_TO_EMAILS=

# Performance
APP_EXECUTION_LIMIT=300
